# Example only. Replace the secret and address through your secret/config manager.
listening-port=3478
tls-listening-port=5349
listening-ip=0.0.0.0
relay-ip=203.0.113.10
external-ip=203.0.113.10
realm=turn.example.com
min-port=49152
max-port=49252
use-auth-secret
static-auth-secret=REPLACE_WITH_HIGH_ENTROPY_CC2_TURN_STATIC_SECRET
fingerprint
lt-cred-mech
no-loopback-peers
no-multicast-peers
mobility
no-cli
log-file=stdout
# For TLS, mount a real certificate chain and private key from a TLS secret:
# cert=/etc/coturn/tls/tls.crt
# pkey=/etc/coturn/tls/tls.key
