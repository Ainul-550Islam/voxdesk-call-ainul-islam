{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "react": ["./src/vite-env.d.ts"],
      "react/jsx-runtime": ["./src/vite-env.d.ts"],
      "react/jsx-dev-runtime": ["./src/vite-env.d.ts"],
      "react-dom": ["./src/vite-env.d.ts"],
      "react-dom/client": ["./src/vite-env.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "src/tests/**", "src/**/__tests__/**"]
}
