# =============================================================================
# .env.check.example — Documented template for local Docker run check
# =============================================================================
# Generated into `.env.check` (mode 0600, git-ignored) by:
#     python scripts/make_check_env.py --out .env.check
#
# Names and comments only — NO real secrets live in this file.
# Combines every `${VAR:?}` required by `docker-compose.prod.yml` with the
# application settings from `.env.example` under `APP_ENV=staging`.
# =============================================================================

# ---------- App & Runtime Posture ----------
APP_ENV=staging
PUBLIC_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=

# ---------- Proxy & Host Allowlists (required by docker-compose.prod.yml) ----------
TRUSTED_HOSTS=localhost,127.0.0.1,api
FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.30.0.10
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# ---------- PostgreSQL & Redis (required by docker-compose.prod.yml) ----------
POSTGRES_USER=voxdesk
POSTGRES_DB=voxdesk
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://voxdesk:@db:5432/voxdesk
REDIS_URL=redis://redis:6379/0

# ---------- Auth / JWT (shared by api and realtime-gateway) ----------
JWT_SECRET=
JWT_ISSUER=voxdesk
JWT_AUDIENCE=voxdesk-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# ---------- Realtime Gateway & Media Engine (required by docker-compose.prod.yml) ----------
REALTIME_GATEWAY_URL=http://realtime-gateway:8790
REALTIME_GATEWAY_INGEST_SECRET=
REALTIME_PUBLISH_TIMEOUT_SECONDS=1.5
REALTIME_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
MEDIA_ENGINE_PUBLIC_IP=127.0.0.1
MEDIA_ENGINE_LABEL=edge-1
MEDIA_ENGINE_MAX_PARTICIPANTS=64
MEDIA_ENGINE_TIMEOUT_SECONDS=1.5
MEDIA_ENGINE_STEER=off

# ---------- Conductor & Observability (required by docker-compose.prod.yml) ----------
CONDUCTOR_WEBHOOK_SECRET=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
METRICS_ENABLED=true
METRICS_TOKEN=
SCHEDULER_METRICS_PORT=8001

# ---------- Owner Bootstrap (used by check_docker.sh Step 6) ----------
DEMO_OWNER_EMAIL=owner@check.local
DEMO_OWNER_PASSWORD=
VOXDESK_OWNER_PASSWORD=

# ---------- External Provider Keys (intentionally blank for offline check) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SKIP_WEBHOOK_VERIFY=false
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_PRESET=natural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
GOOGLE_CREDENTIALS_JSON=
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_TRANSPORT=log
E2E_ENABLED=false
E2E_TEST_NUMBER=
E2E_ALLOWED_CALLERS=
