<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  PART 13 / P13-01 — the number does not exist.

  404 is `invalid_destination` and must never be retried: redialling a number
  that does not exist is how a tenant's traffic gets flagged as spam.
-->
<scenario name="outbound-404">
  <recv request="INVITE" timeout="10000" />
  <send>
    <![CDATA[
      SIP/2.0 404 Not Found
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag03[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>
  <recv request="ACK" timeout="5000" optional="true" />
</scenario>
