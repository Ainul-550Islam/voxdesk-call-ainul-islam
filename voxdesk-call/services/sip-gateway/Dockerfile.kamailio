# The Kamailio signalling proxy.
#
# This is the signalling edge of the SIP ingress: it terminates the SIP
# connections and hands the media to the gateway. It was the whole
# services/sip-gateway image before the Go gateway existed; the image is
# kept as Dockerfile.kamailio so a deployment can run the proxy, the
# gateway, or both.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    kamailio \
    kamailio-tls-modules \
    kamailio-extra-modules \
    kamailio-json-modules \
    kamailio-http-async-client-modules \
    kamailio-websocket-modules \
    ca-certificates \
    curl \
    python3-minimal \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/secrets/voxdesk-sip

COPY kamailio.cfg /etc/kamailio/kamailio.cfg.template
COPY tls.cfg /etc/kamailio/tls.cfg
COPY kamailio-entrypoint.sh /usr/local/bin/kamailio-entrypoint
RUN chmod 0755 /usr/local/bin/kamailio-entrypoint

EXPOSE 5061/tcp
ENTRYPOINT ["/usr/local/bin/kamailio-entrypoint"]
