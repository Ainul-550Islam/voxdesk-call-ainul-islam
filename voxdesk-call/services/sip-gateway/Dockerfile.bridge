# Standalone RTP <-> app WebSocket bridge for deployments that use an external
# SIP/RTP relay. The primary SIP gateway is the Go image in ./Dockerfile; this
# image remains useful for a per-call bridge launched by a separate controller.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/voxdesk-sip

COPY bridge ./bridge
COPY bridge/requirements.txt ./bridge/requirements.txt
RUN pip install --no-cache-dir --only-binary=:all: -r bridge/requirements.txt \
 && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin bridge

USER 10001:10001

# BRIDGE_RTP_PORT is allocated per call by the signalling controller. The
# default is only documentation; the container must be given its actual port.
EXPOSE 40000/udp

ENTRYPOINT ["python3", "-m", "bridge.main"]
