__pycache__/
*.py[cod]
.venv/
.env
secrets/
recordings/
node_modules/
dist/
/build/
.pytest_cache/
.ruff_cache/

# Database dumps and backup artifacts: they contain the whole business,
# calls and PII included, and must never be committable even by accident.
backups/
backups-staging/
*.dump
*.pem
*.key
.netrc

# Staging's own env file. docker-compose.staging.yml tells operators to create
# it with REAL staging credentials (DB password, JWT secret, Twilio test
# numbers), so it must be ignored exactly like .env — while the template
# (.env.staging.example) stays tracked for copying. The API image build never
# sees it either (.dockerignore carries the same rule via `.env.*`).
.env.staging
# Generated by scripts/make_check_env.py (mode 0600, holds live-style secrets). Never track.
.env.check

# Local tooling state.
.idea/
.vscode/
*.swp

# Realtime gateway build artifacts (Go test/build run from the repo tree).
/services/realtime/gateway-go/gateway

# Sandbox toolchain + Go module caches, and NLTK corpora: build/download artifacts,
# not source. restore-tooling.sh recreates the toolchains ($HOME/toolchains, $HOME/go-work).
toolchains/
go-work/
gop/
/go/pkg/
nltk_data/

# Rust build output (cargo check/test run from the repo tree).
/services/realtime/media-engine-rs/target/

# Control-plane build output (cargo check/test run from the repo tree) and the
# media-plane's make(1) output directory.
/services/control-plane/target/
/services/media-plane/build/
# Python & Virtualenv
__pycache__/
*.py[cod]
venv/
.venv/
env/

# Vendor & Node modules
vendor/
!services/realtime/media-engine-rs/vendor/
!services/realtime/media-engine-rs/vendor/**
node_modules/

# Reports, Logs & Temporary Files
var/
*.log
*.patch
!docs/archive/**
!reports/**
reports/check/*.json
reports/check/*.csv
reports/check/*.log
reports/check/*.txt
reports/check/chunks/*.xml
reports/check/junit/
!reports/check/.gitkeep
!reports/check/*.md
.cache/*
# ...except the fingerprinted pytest collection count. scripts/pytest_collection_stats.py
# invalidates it from the test sources and the pytest environment, so shipping it is safe,
# and without it a fresh export has to re-collect 8k nodes before any doc number can be
# checked - the slowest possible way to prove README.md is right.
!.cache/pytest-collection-stats.json
docs/archive/PART_0_REPORT_pre-reaudit.md
docs/archive/part0-initial-evidence/openapi-before.json

# >>> voxdesk:repo-cleanup >>>
# Managed by scripts/repo_cleanup.sh -- keep the markers intact.
# Run output from local runs and CI.
*.log
logs/
# Previous delivery archives; the current one is produced on demand.
*.zip
# Generated evidence: bulk output is regenerated, not committed. The structured
# PART 11 ledgers named by tests/truth/test_part11_evidence_and_bench.py are the
# committed record of a run, so those directories are deliberately re-included.
# Archived pre-task snapshots and re-audit dumps: genuine history, but 12.5 MiB
# of duplicate source dumps. They stay in git history; keep them out of the tree
# (see tests/truth/test_repo_size_budget.py).
docs/archive/*
!docs/archive/history/
# Test/bootstrap key material written by the runtime and the suite.
secrets-staging/
backups-staging/
var/

evidence/*
!evidence/real-integrations/
!evidence/latency/
!evidence/capacity/
!evidence/mock/
!evidence/demo/
!evidence/staging/
!evidence/live/
!evidence/junit/
!evidence/batch07/
!evidence/dr/
!evidence/pack/
# Binary demo audio lives in GitHub Release assets, never in git.
evidence/demo/*.wav
# The small *_SUMMARY.json files are the committed record of a CI run.
reports/**
# `reports/**` excludes the *directory* `reports/check/`, and git never descends into an
# excluded directory, so a negation like `!reports/**/*.md` cannot re-include the check
# reports — the rule looked like "keep the .md files" while silently untracking them for
# anyone who added the tree fresh (the original history had them only because they were
# force-added once). Re-including the directory is what makes the file negations work.
!reports/check/
!reports/check/.gitkeep
!reports/**/*.md
!reports/*_SUMMARY.json
!reports/deploy_asset_validation.json
!reports/.gitkeep
coverage.xml
htmlcov/
.pytest_cache/
# The 8.5 MB pytest dump has been superseded by reports/TEST_EVIDENCE_SUMMARY.json.
FINAL_TEST_RESULTS.json
# <<< voxdesk:repo-cleanup <<<

# ---- PART 10 (P10-06): generated config, artifacts and build output ----
# Every `.env`-shaped file is generated (scripts/make_check_env.py, operator
# copies of the shipped examples) and must never be tracked — the ignore rule
# that used to cover only `.env`, `.env.staging` and `.env.check` let
# `scripts/live_local.env` into git. The `!…example` exceptions keep the
# templates tracked, because those are the files an operator copies from.
.env.*
# `scripts/live_local.env` is exactly this shape: a name ending in `.env`, not
# starting with it. Ignore both, and keep the `.example` templates readable.
*.env
!*.env.example
!.env.example
!.env.*.example
# Command output and evidence dumps written by `make *-evidence`, `make
# check-*` and the validation scripts. They belong on disk, not in a clone.
artifacts/
# Compiled object files: `make`/CI builds them, a clone must not carry them.
*.a
*.o
