__pycache__/
*.py[cod]
.venv/
.env
secrets/
recordings/
node_modules/
dist/
.pytest_cache/
.ruff_cache/

# Database dumps and backup artifacts: they contain the whole business,
# calls and PII included, and must never be committable even by accident.
backups/
backups-staging/
*.dump
*.pem
*.key
.netrc

# Staging's own env file. docker-compose.staging.yml tells operators to create
# it with REAL staging credentials (DB password, JWT secret, Twilio test
# numbers), so it must be ignored exactly like .env — while the template
# (.env.staging.example) stays tracked for copying. The API image build never
# sees it either (.dockerignore carries the same rule via `.env.*`).
.env.staging

# Local tooling state.
.idea/
.vscode/
*.swp

# Realtime gateway build artifacts (Go test/build run from the repo tree).
/services/realtime/gateway-go/gateway

# Sandbox toolchain + Go module caches, and NLTK corpora: build/download artifacts,
# not source. restore-tooling.sh recreates the toolchains ($HOME/toolchains, $HOME/go-work).
toolchains/
go-work/
gop/
/go/pkg/
nltk_data/

# Rust build output (cargo check/test run from the repo tree).
/services/realtime/media-engine-rs/target/

# Control-plane build output (cargo check/test run from the repo tree) and the
# media-plane's make(1) output directory.
/services/control-plane/target/
/services/media-plane/build/
# Python & Virtualenv
__pycache__/
*.py[cod]
venv/
.venv/
env/

# Vendor & Node modules
vendor/
node_modules/

# Reports, Logs & Temporary Files
var/
*.log
*.patch
!docs/archive/**
!reports/**
reports/check/*.json
reports/check/*.csv
reports/check/*.log
reports/check/*.txt
reports/check/chunks/*.xml
reports/check/junit/
!reports/check/.gitkeep
!reports/check/*.md
