# Template for `scripts/live_local.env` — copy it, then fill in the values of the
# services you actually run:
#
#   cp scripts/live_local.env.example scripts/live_local.env
#   set -a; . scripts/live_local.env; set +a
#
# The real file is gitignored and must never be committed: it carries credentials
# whether or not they belong to a laptop. This template keeps every value blank or
# an obvious placeholder so tests/truth/test_no_tracked_secrets.py can assert that.
export DATABASE_URL='postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/voxdesk'
export CC2_POSTGRES_TEST_URL='postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/voxdesk_cc2'
export VOXDESK_LIVE_TESTS=1
export SIP_GATEWAY_URL='http://127.0.0.1:18080'
export SIP_GATEWAY_TOKEN=''
export VOXDESK_LIVE_AUDIT_SIGNING_KEY_PATH=''
export VOXDESK_LIVE_SYSLOG_HOST='127.0.0.1'
export VOXDESK_LIVE_SYSLOG_PORT='6514'
export VOXDESK_LIVE_SYSLOG_TLS='0'
export VOXDESK_LIVE_SPLUNK_HEC_URL='http://127.0.0.1:18088'
export VOXDESK_LIVE_SPLUNK_HEC_TOKEN=''
export VOXDESK_LIVE_ELASTIC_URL='http://127.0.0.1:18088'
export VOXDESK_LIVE_ELASTIC_INDEX='voxdesk-audit'
export VOXDESK_LIVE_ELASTIC_API_KEY=''
export VOXDESK_LIVE_DATADOG_API_KEY=''
export VOXDESK_LIVE_DATADOG_ENDPOINT='http://127.0.0.1:18088/api/v2/logs'
export PGHOST=127.0.0.1
export PGPORT=5432
export POSTGRES_USER=''
export PGPASSWORD=''
